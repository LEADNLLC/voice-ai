# VOICE Configuration
# Copy this to .env and fill in your values
# Or set these in Railway dashboard: Settings → Variables
#
# ⚠️ REQUIRED - the app will not place calls without these.
# They no longer have hardcoded fallbacks in voice_app.py (removed 2026-08-21
# after being exposed in a public repo). Set them in Railway BEFORE deploying.

# Retell (AI voice) - Get from dashboard.retellai.com → API Keys
RETELL_API_KEY=your_retell_api_key_here

# Outbound caller ID - must be a number you own in Retell, SMS enabled
HAILEY_PHONE_NUMBER=+17027105676
RETELL_PHONE_NUMBER=+17027105676
SMS_PHONE_NUMBER=+17027105676

# Shared secret for internal/scheduled call endpoints (X-Internal-Key header).
# If unset, internal-key auth is refused outright rather than allowed through.
INTERNAL_API_KEY=generate_a_long_random_string

# GoHighLevel
GHL_API_KEY=your_ghl_api_key_here
GHL_LOCATION_ID=your_ghl_location_id

# VAPI (Voice AI) - Get from vapi.ai
VAPI_API_KEY=your_vapi_api_key_here
VAPI_PHONE_ID=your_vapi_phone_id_here

# Twilio (SMS) - Get from twilio.com/console
TWILIO_SID=your_twilio_account_sid
TWILIO_TOKEN=your_twilio_auth_token
TWILIO_PHONE=+1234567890

# Test Phone Number
TEST_PHONE=+1234567890

# OpenAI (for Aria assistant) - Get from platform.openai.com
OPENAI_API_KEY=sk-your_openai_key

# Google Calendar (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Company Info
COMPANY_NAME=VOICE
COMPANY_PHONE=+1234567890
