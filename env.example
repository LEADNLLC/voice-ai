# VOICE Configuration
# Copy this to .env and fill in your values
# Or set these in Railway dashboard: Settings → Variables
#
# ⚠️ REQUIRED - the app will not place calls without these.
# They no longer have hardcoded fallbacks in voice_app.py (removed 2026-08-21
# after being exposed in a public repo). Set them in Railway BEFORE deploying.

# Retell (AI voice) - Get from dashboard.retellai.com → API Keys
RETELL_API_KEY=your_retell_api_key_here

# (Outbound caller ID + SMS sender are defined together in the Numbers block below.)

# Shared secret for internal/scheduled call endpoints (X-Internal-Key header).
# If unset, internal-key auth is refused outright rather than allowed through.
INTERNAL_API_KEY=generate_a_long_random_string

# GoHighLevel
GHL_API_KEY=your_ghl_api_key_here
GHL_LOCATION_ID=your_ghl_location_id

# VAPI (Voice AI) - Get from vapi.ai
VAPI_API_KEY=your_vapi_api_key_here
VAPI_PHONE_ID=your_vapi_phone_id_here

# Twilio (SMS) - Get from twilio.com/console
TWILIO_SID=your_twilio_account_sid
TWILIO_TOKEN=your_twilio_auth_token
TWILIO_PHONE=+1234567890

# Test Phone Number
TEST_PHONE=+1234567890

# OpenAI (for Aria assistant) - Get from platform.openai.com
OPENAI_API_KEY=sk-your_openai_key

# Google Calendar (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Company Info
COMPANY_NAME=VOICE
COMPANY_PHONE=+1234567890

# Booking calendar: resolved BY NAME at runtime (run ghl_calendars.py to confirm the
# exact name). Falls back to GHL_CALENDAR_ID if the name doesn't match.
GHL_CALENDAR_NAME=ILLINOIS - VIRTUAL

# Timezone the times Hailey SPEAKS are in. Denver leads hear their own local time,
# so this is Mountain even though the calendar itself is Illinois/Central.
GHL_TIMEZONE=America/Denver

# Pipeline stage a contact moves to when Hailey books. Resolved BY NAME.
# Leave GHL_PIPELINE_NAME blank to search every pipeline for the stage.
GHL_PIPELINE_NAME=
GHL_APPT_STAGE_NAME=Appointment Set

# Phone that gets the "appointment set" text
APPT_ALERT_PHONE=+17026721251

# ── Numbers ──────────────────────────────────────────────────────────────────
# +17206054003 - Denver 720, bought inside Retell. Retell-native: no SIP trunk, so
# it carries both calls and texts. Texts need A2P 10DLC registration first.
#
# Do NOT point these at a SIP-trunked number without a test call that rings - the
# SignalWire 720 (+17206864625) failed every call with 404 Domain unavailable.
HAILEY_PHONE_NUMBER=+17206054003
RETELL_PHONE_NUMBER=+17206054003
SMS_PHONE_NUMBER=+17206054003

# ── Call sequence hygiene ────────────────────────────────────────────────────
# Active sequences older than this are auto-cleared instead of blocking forever.
SEQUENCE_STALE_DAYS=8
# Numbers that can always restart a sequence (your test cell). Comma-separated.
TEST_PHONES=+17026721251
