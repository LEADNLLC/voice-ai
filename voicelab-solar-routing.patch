From e3199bed8e2fad32b47494635c8073b88384389b Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 21 Aug 2026 20:52:38 +0000
Subject: [PATCH 3/3] Pull address/state/phone from GHL contact record; scrub
 unresolved merge fields

---
 voice_app.py | 126 +++++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 126 insertions(+)

diff --git a/voice_app.py b/voice_app.py
index dfec52f..3f0a898 100644
--- a/voice_app.py
+++ b/voice_app.py
@@ -3256,6 +3256,76 @@ def ghl_get_contacts(limit=100, query=None, startAfterId=None):
         params['startAfterId'] = startAfterId
     return ghl_request('GET', '/contacts/', params=params)
 
+def clean_ghl_value(value):
+    """Normalize a GHL merge-field value to '' when it didn't actually resolve.
+
+    An unresolved GHL merge field arrives as the literal STRING 'undefined' (or
+    'null'/'None'), not as an empty value. Treating those as real data is how
+    Hailey ends up saying "your place at undefined".
+    """
+    if value is None:
+        return ''
+    s = str(value).strip()
+    if s.lower() in ('undefined', 'null', 'none', 'n/a', 'na', '{{contact.address1}}'):
+        return ''
+    # Any leftover unrendered merge field, e.g. '{{contact.address1}}'
+    if s.startswith('{{') and s.endswith('}}'):
+        return ''
+    return s
+
+
+def ghl_get_contact(contact_id):
+    """Fetch a single contact by ID. Returns the contact dict, or {} on failure."""
+    if not contact_id:
+        return {}
+    resp = ghl_request('GET', f'/contacts/{contact_id}')
+    if not isinstance(resp, dict) or resp.get('error'):
+        print(f"⚠️ GHL contact fetch failed for {contact_id}: {resp.get('error') if isinstance(resp, dict) else resp}")
+        return {}
+    # GHL v2 nests the record under a 'contact' key
+    return resp.get('contact', resp) or {}
+
+
+def ghl_fetch_contact_details(contact_id):
+    """Pull address/phone/name straight from GHL as the source of truth.
+
+    The webhook payload is only as good as the merge fields in the workflow. This
+    reads the contact record itself, so Hailey has the address without asking and
+    without depending on GHL templating.
+
+    Returns a normalized dict; missing values are '' (never 'undefined').
+    """
+    c = ghl_get_contact(contact_id)
+    if not c:
+        return {}
+
+    street = clean_ghl_value(c.get('address1') or c.get('address'))
+    city = clean_ghl_value(c.get('city'))
+    state = clean_ghl_value(c.get('state'))
+    postal = clean_ghl_value(c.get('postalCode') or c.get('postal_code'))
+
+    # Build a natural spoken address. Street alone is what Hailey should say;
+    # the full version is kept for notes and dynamic variables.
+    parts = [p for p in (street, city, state) if p]
+    full = ', '.join(parts)
+    if postal and full:
+        full = f"{full} {postal}"
+
+    details = {
+        'first_name': clean_ghl_value(c.get('firstName')),
+        'last_name': clean_ghl_value(c.get('lastName')),
+        'email': clean_ghl_value(c.get('email')),
+        'phone': clean_ghl_value(c.get('phone')),
+        'address': street,
+        'city': city,
+        'state': state,
+        'postal_code': postal,
+        'full_address': full,
